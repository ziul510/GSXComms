package gl

import (
	"log"
	"os"
	"unsafe"

	"github.com/go-gui-org/go-gui/gui"
	gogl "github.com/go-gui-org/go-gui/gui/backend/internal/glbind"
	"github.com/go-gui-org/go-gui/gui/backend/soft"
	"golang.org/x/sys/windows"
)

var stretchDIBits = windows.NewLazySystemDLL("gdi32.dll").NewProc("StretchDIBits")

type dibHeader struct {
	size uint32
	width,height int32
	planes,depth uint16
	compression,imageSize uint32
	xDensity,yDensity int32
	colors,usedColors uint32
}

func (b *Backend) win32Renderer(w *gui.Window) error {
	b.dpiScale=windowScale(b.plat.hwnd)
	b.physW,b.physH=clientSize(b.plat.hwnd)
	b.initCaches(w.Config)
	if os.Getenv("GOGUI_RENDERER")=="soft" { return b.win32Software(w) }

	context,err:=createContextFunc(b.plat.hdc)
	if err==nil {
		b.plat.hglrc=context
		applyVSync(w.Config.VSyncOff, wglSetSwapInterval, w.DebugWindowVSync, "wglSwapIntervalEXT")
		err=gogl.InitWithProcAddrFunc(glProc)
		if err==nil {
			err=b.initGLResources(w)
			if err==nil{return nil}
			b.destroyGLResources()
		}
		// Detach the failed GL context before switching the window to GDI.
		wglMakeCurrent(0,0)
		wglDeleteContext(context)
		b.plat.hglrc=0
	}
	log.Printf("go-gui: software renderer selected: %v",err)
	return b.win32Software(w)
}

func(b *Backend) win32Software(w *gui.Window)error{
	if err:=soft.PrepareDisplay(w,b.dpiScale);err!=nil{return err}
	w.BackingScale=b.dpiScale
	w.SetNativePlatform(&nativePlatform{b:b})
	gui.SetWindowRendersShaders(w,false)

	var pixels []byte
	last:=dibHeader{size:40,planes:1,depth:32}
	// WM_PAINT passes nil to blit the last frame.
	b.softwarePresent=func(w *gui.Window){
		if w!=nil {
			img,err:=soft.RenderDisplay(w,b.dpiScale)
			if err!=nil {log.Printf("go-gui: software render: %v",err);return}
			last.width=int32(img.Rect.Dx())
			// A negative DIB height keeps the top row first.
			last.height=-int32(img.Rect.Dy())
			if cap(pixels)<len(img.Pix){pixels=make([]byte,len(img.Pix))}else{pixels=pixels[:len(img.Pix)]}
			for i:=0;i+3<len(pixels);i+=4{
				pixels[i],pixels[i+1],pixels[i+2],pixels[i+3]=img.Pix[i+2],img.Pix[i+1],img.Pix[i],255
			}
		}
		if len(pixels)==0||b.physW<=0||b.physH<=0{return}
		stretchDIBits.Call(b.plat.hdc,0,0,uintptr(b.physW),uintptr(b.physH),
			0,0,uintptr(last.width),uintptr(-last.height),uintptr(unsafe.Pointer(&pixels[0])),
			uintptr(unsafe.Pointer(&last)),0,0x00CC0020)
	}
	b.softwareRelease=func(){soft.Release(w)}
	return nil
}
